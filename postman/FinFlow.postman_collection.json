{
  "info": {
    "name": "FinFlow Production Playground",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-demo-1"
          }
        ],
        "url": "http://localhost:8084/api/v1/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceAccountId\": \"11111111-1111-1111-1111-111111111111\",\n  \"destinationAccountId\": \"22222222-2222-2222-2222-222222222222\",\n  \"amount\": 25.00,\n  \"currency\": \"USD\"\n}"
        }
      }
    }
  ]
}